# macOS metadata
.DS_Store
**/.DS_Store

# Local coding-agent runtime artifacts and configuration (not for publication)
/.pi-subagents/
/.pi/
/.agents/

# Generated synthetic fixtures and private/local study inputs.
# Keep only the schema and data-handling documentation by default; public data
# must be explicitly allow-listed before it is committed.
/data/*
!/data/README.md

# Generated analysis outputs. Recreate them with the Makefile targets.
/results/

# Editor and temporary files
*~
*.swp
*.swo

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
# CocoIndex Code (ccc)
/.cocoindex_code/
